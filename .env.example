# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Trading Mode: paper (simulated) or live (real broker)
TRADING_MODE=paper

# Risk management
RISK_PER_TRADE=0.02         # 2% of portfolio per trade
MAX_POSITIONS=8             # Maximum concurrent positions
PORTFOLIO_CASH=100000.00    # Starting cash for paper trading

# Model selection
CLAUDE_MODEL=claude-sonnet-4-6

# Data refresh interval (seconds) for portfolio tracker
REFRESH_INTERVAL=900        # 15 minutes
